# Porta serial usada na gravacao por USB
ESP32_USB_PORT=/dev/ttyACM0
ESP32_WINDOWS_PORT=COM3
# Endereco do relogio na rede (usado apenas na gravacao OTA)
ESP32_OTA_HOST=IP_DO_RELOGIO

WIFI_SSID=NOME_DA_REDE
WIFI_PASSWORD=SENHA_DA_REDE

OTA_HOSTNAME=twatch-s3-epi
OTA_PASSWORD=TROQUE_ESTA_SENHA

# 0 = usa apenas a rede configurada em WIFI_SSID.
# 1 = tambem cria a rede propria do relogio para acesso direto.
WEB_AP_MODE=0
WEB_AP_SSID=TWATCH-EPI
WEB_AP_PASSWORD=TROQUE_ESTA_SENHA
