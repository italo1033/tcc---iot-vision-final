# ============================================================
# IoT Vision - credenciais e ajustes (NAO publique este arquivo)
# ============================================================

# Camera ao vivo (Intelbras/DVR) - usado pelo executavel 2 e pela coleta do TCC
RTSP_URL=rtsp://USUARIO:SENHA@IP_DA_CAMERA:554/cam/realmonitor?channel=6&subtype=0

# Telegram
TELEGRAM_BOT_TOKEN=COLE_AQUI
TELEGRAM_CHAT_ID=COLE_AQUI

# E-mail (opcional, desligado por padrao; o Gmail exige senha de aplicativo)
EMAIL_REMETENTE=COLE_AQUI
EMAIL_DESTINATARIO=COLE_AQUI
EMAIL_SENHA=COLE_AQUI
EMAIL_SMTP_SERVIDOR=smtp.gmail.com
EMAIL_SMTP_PORTA=465

# Relogio: deixe vazio para usar smartwatch.json + busca automatica na rede
SMARTWATCH_URL=

# Ajustes do detector (valores padrao do TCC)
MODELO_EPI=modelos/REF01_best.pt
CONFIANCA=0.40
IOU=0.45
IMGSZ=640
FRAMES_CONFIRMACAO=3
DETECTAR_PESSOA=1
INTERVALO_MINIMO_ALERTA_S=15
REPETIR_ALERTA_S=60
MENSAGEM_RELOGIO=Anomalia identificada: falta de EPI

# Canais (1 = ligado, 0 = desligado)
NOTIFICAR_RELOGIO=1
NOTIFICAR_TELEGRAM=1
NOTIFICAR_EMAIL=0

# Recorte por pessoa: amplia cada pessoa antes de procurar os EPIs (melhora camera distante)
RECORTE_PESSOA=1
IMGSZ_PESSOA=640
MAX_PESSOAS=4
# Enquanto irregular, o relogio fica vermelho mostrando o que falta e vibra a cada N segundos
RELOGIO_VIBRAR_A_CADA_S=10
